# Copy to `.env` and fill in. Rebuild after changing values.
# (Vite embeds these at build time; they are NOT read at runtime.)

# Supabase project URL (public-by-design; embedded in the browser bundle).
# Leads are sent to the public `genba-lead` Edge Function, never directly to
# the DB. No Supabase key is needed: the function takes none.
# Tip: `npm run dev:live` fills this from Infisical for you (see README).
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# NEVER put any Supabase key (publishable, secret, service-role) in a VITE_*
# variable -- everything prefixed with VITE_ ends up in the public JS bundle.

# Contact emails shown on the landing page. Empty = hidden until set.
VITE_SALES_EMAIL=
VITE_SUPPORT_EMAIL=

# Optional: POST JSON analytics events here. Empty = no-op (dev logs only).
VITE_ANALYTICS_ENDPOINT=
