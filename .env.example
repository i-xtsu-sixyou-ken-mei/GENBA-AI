# Copy to `.env` and fill in. Rebuild after changing values.
# (Vite embeds these at build time; they are NOT read at runtime.)

# Supabase project (public-by-design; embedded in the browser bundle).
# Leads are sent to the `genba-lead` Edge Function, never directly to the DB.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# NEVER put a secret / service-role key in any VITE_* variable --
# everything prefixed with VITE_ ends up in the public JS bundle.

# Contact emails shown on the landing page. Empty = hidden until set.
VITE_SALES_EMAIL=
VITE_SUPPORT_EMAIL=

# Optional: POST JSON analytics events here. Empty = no-op (dev logs only).
VITE_ANALYTICS_ENDPOINT=
